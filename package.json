  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "rm -rf dist && npx tsc",
    "dev": "nodemon --config nodemon.json --exec \"npx tsc && yarn start\"",
    "dev-docker": "npx nodemon --config nodemon.json --exec \"npx tsc --outdir /dist && yarn start-docker\"",
    "start": "node -r source-map-support/register dist/src/app.js",
    "start-docker": "node -r source-map-support/register /dist/src/app.js",
    "typeorm": "typeorm-ts-node-commonjs -d src/AppDataSource.ts",
    "typeorm-raw": "typeorm-ts-node-commonjs",
    "migration:run:prod": "typeorm migration:run -d dist/src/AppDataSource.js"
  },
  "keywords": [],
  "author": "",
  "description": "",
  "dependencies": {
    "@simplewebauthn/server": "^13.3.2",
    "axios": "^1.18.0",
    "base64url": "^3.0.1",
    "body-parser": "^1.20.8",
    "cbor-x": "^1.6.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.22.3",
    "inversify": "^6.0.1",
    "jose": "^4.9.3",
    "mysql": "^2.18.1",
    "mysql2": "^3.24.5",
    "node-fetch": "2",
    "reflect-metadata": "^0.1.13",
    "ts-results": "^3.3.0",
    "typeorm": "^0.3.31",
    "uuid": "^11.1.1",
    "ws": "^8.22.0",
    "zod": "^3.21.4"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.2",
    "@types/cookie-parser": "^1.4.3",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.13",
    "@types/node": "24.13.3",
    "@types/node-fetch": "^2.6.4",
    "@types/ws": "^8.18.1",
    "nodemon": "^2.0.19",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  }
}
